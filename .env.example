DATABASE_URL="postgresql://seu_usuario:sua_senha@localhost:5432/AV2?schema=public"
JWT_SECRET="substitua-por-um-segredo-aleatorio-com-pelo-menos-32-bytes"
API_KEY_PEPPER="substitua-por-outro-segredo-aleatorio-com-pelo-menos-32-bytes"
REDIS_URL="redis://localhost:6379"
PUBLIC_API_RATE_LIMIT="100"
PUBLIC_API_RATE_WINDOW="1 minute"
REPORTS_DIR=".data/reports"
REPORT_RETENTION_DAYS="7"
WORKER_CONCURRENCY="2"
# Opcional: cron diário ou semanal para a análise operacional. Sem valor, não agenda análise automática.
OPERATIONAL_ANALYSIS_CRON=""
# Limpeza de relatórios expirados (cron do node-cron).
REPORT_CLEANUP_CRON="17 3 * * *"
